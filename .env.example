# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookpos?retryWrites=true&w=majority

# Port Server Flask Lokal (default: 5000)
PORT=5000

TARIF_PAJAK=0
# Kunci Rahasia JWT (ganti dengan string acak yang aman di production)
JWT_SECRET=super-secret-key-change-me

# Saklar Autentikasi (1 = aktif/wajib login, 0 = nonaktifkan untuk dev/testing)
AUTH_REQUIRED=1
